rules_version = '2';

// =============================================================
// GENTE ESCUTA — Regras de segurança do Firestore
//
// O site é estático; não há servidor. Estas regras SÃO a segurança.
// Princípio: o público só lê o que precisa e só cria (envia); tudo
// que é sensível (manifestações, respostas) só o admin logado lê.
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function seed() {
      return request.auth.token.email == 'gentecultura@soulan.com.br';
    }
    function temConta() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function conta() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    // Funcionário ATIVO com o papel "master" (Master Administrador = admin
    // completo, mesmo poder do e-mail semente). O papel legado "administrador"
    // também conta como Master, para ninguém perder acesso antes da migração.
    function funcMasterAtivo() {
      return logado()
        && exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data.ativo == true
        && (
          'master' in get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data.get('papeis', [])
          || 'administrador' in get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data.get('papeis', [])
        );
    }
    // Admin = e-mail semente OU conta ATIVA em /admins (master/super) OU
    // funcionário ativo com o papel "master".
    function admin() {
      return logado() && (
        seed()
        || (temConta() && conta().ativo == true && conta().nivel in ['master', 'super'])
        || funcMasterAtivo()
      );
    }
    // Gerir CONTEÚDO do site (mural, informações, treinamento, contato,
    // sobre/missão) e tratar o Canal: só o Master Administrador. (O antigo papel
    // "Administrador" foi removido; o acesso dele passou a ser do Master.)
    function podeConteudo() {
      return admin();
    }
    // Super Admin = controle total (edita config, gerencia admins, cria níveis).
    function souSuper() {
      return logado() && ( seed() || (temConta() && conta().ativo == true && conta().nivel == 'super') );
    }
    // Gerente = master ou super (gerenciam funcionários e moderação).
    function gerente() {
      return admin();
    }

    // Funcionário ativo (colaborador que loga para reagir/comentar).
    function funcionarioAtivo() {
      return logado()
        && exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data.ativo == true;
    }
    // Participante = admin ativo OU funcionário ativo (pode reagir/comentar).
    function participante() {
      return admin() || funcionarioAtivo();
    }

    // -------- Papéis de acesso (uma pessoa pode ter vários) --------
    // Os papéis e o centro de custo ficam no doc do usuário (admins OU
    // funcionarios). Estas funções leem de onde a pessoa estiver.
    function docAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function docFunc() {
      return get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data;
    }
    function papeisDe() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? docAdmin().get('papeis', [])
        : (exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid))
            ? docFunc().get('papeis', []) : []);
    }
    function temPapel(p) {
      return logado() && (p in papeisDe());
    }
    function meuCentro() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? docAdmin().get('centro_custo', '')
        : (exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid))
            ? docFunc().get('centro_custo', '') : '');
    }
    // Master = admin do painel (nível master/super ou semente) OU papel 'master'.
    function ehMaster() {
      return admin() || temPapel('master');
    }
    // Gente e Cultura (Protocolo de Assédio): a conta semente OU quem tem o papel
    // dedicado 'gente_cultura'. É mais restrito que admin: a Diretoria e os demais
    // Masters NÃO entram aqui a menos que recebam o papel. Lê e trata os relatos.
    function ehGenteCultura() {
      return logado() && ( seed() || temPapel('gente_cultura') );
    }

    // -------- Configuração da empresa: pública para ler.
    // Só SUPER edita configurações; a classificação de humor (config/humor)
    // é de dashboard, então master também pode salvar.
    match /config/{doc} {
      allow read: if true;
      // Super edita tudo; Master edita a classificação de humor; o Administrador
      // (e Master) edita os conteúdos do site (Contato, Sobre, Missão/Visão/Valores).
      allow write: if souSuper()
        || (doc == 'humor' && admin())
        || (doc == 'assedio' && ehGenteCultura())
        || ((doc == 'contato' || doc == 'sobre' || doc == 'missao' || doc == 'treinamento' || doc == 'carrossel') && podeConteudo());
    }

    // -------- Áreas/setores: público lê; só SUPER edita (é configuração).
    match /areas/{id} {
      allow read: if true;
      allow write: if souSuper();
    }

    // -------- "Qual solicitação você deseja realizar?" (orientações)
    // Público lê (a filtragem por papel/visibilidade é feita na consulta do
    // cliente). Admin/administrador de conteúdo gerencia os itens.
    match /orientacao_solicitacoes/{id} {
      allow read: if true;
      allow create, update, delete: if podeConteudo();
    }

    // -------- Slides do carrossel da home. Público lê; conteúdo gerencia.
    match /carrossel_slides/{id} {
      allow read: if true;
      allow create, update, delete: if podeConteudo();
    }

    // -------- Usuários da administração (Master/Super). Só o SUPER cria,
    // altera nível e remove. Admin lê a lista. A própria pessoa só pode
    // baixar o flag de senha provisória (nada mais).
    match /admins/{uid} {
      allow read: if admin();
      allow create, delete: if souSuper();
      allow update: if souSuper()
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senha_provisoria'])
            && request.resource.data.senha_provisoria == false);
    }

    // -------- Funcionários (colaboradores que logam para participar do mural)
    // Gerentes cadastram/gerenciam. A pessoa lê o próprio doc (para o perfil)
    // e pode baixar só o próprio flag de senha provisória.
    match /funcionarios/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create: if gerente();
      allow update: if gerente()
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senha_provisoria'])
            && request.resource.data.senha_provisoria == false);
      allow delete: if gerente();
    }

    // -------- Auditoria de logs (login e ações do admin)
    // Admin ativo LÊ; cada usuário autenticado só grava logs do próprio uid.
    // Imutável: nunca edita nem apaga.
    match /logs/{id} {
      allow read: if souSuper();
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // -------- Pesquisas
    // Público lê só as ABERTAS (para responder). Admin lê/escreve tudo.
    match /pesquisas/{id} {
      // Público lê as ABERTAS; admin (master/super) lê para os painéis.
      // Só SUPER cria/edita/abre/fecha pesquisas (é configuração do sistema).
      allow read: if resource.data.status == 'aberta' || admin();
      allow create, update, delete: if souSuper();

      // Respostas: qualquer um ENVIA; só o admin LÊ. Nunca edita/apaga.
      match /respostas/{rid} {
        allow create: if true;
        allow read: if admin();
        allow update, delete: if false;
      }

      // Trava de duplicata: o ID é o hash do e-mail. Só cria uma vez.
      match /dedup/{hash} {
        allow create: if true;
        allow read, update, delete: if false;
      }
    }

    // -------- Manifestações (contêm nome/e-mail/relato de assédio)
    // Qualquer um CRIA (identificado guarda autor_uid = quem enviou; anônimo = null).
    // Admin/administrador LÊ e trata tudo. O AUTOR lê e exclui só as SUAS.
    match /manifestacoes/{id} {
      allow create: if request.resource.data.autor_uid == null
        || (request.auth != null && request.resource.data.autor_uid == request.auth.uid);
      allow read: if podeConteudo()
        || (request.auth != null && resource.data.get('autor_uid', null) == request.auth.uid);
      allow update: if podeConteudo();
      allow delete: if podeConteudo()
        || (request.auth != null && resource.data.get('autor_uid', null) == request.auth.uid);
    }

    // -------- Relatos do Protocolo de Assédio (canal RESTRITO) --------
    // Coleção separada das manifestações comuns: um relato de assédio NUNCA
    // entra na lista normal do Canal. Qualquer pessoa ENVIA (anônimo guarda
    // autor_uid = null; identificado = quem enviou). A leitura e o tratamento
    // ficam travados AQUI só para Gente e Cultura (papel 'gente_cultura' ou a
    // conta semente): nem gestor, nem colaborador, nem a Diretoria acessam,
    // nem por URL direta nem pela API. O próprio autor também não relê (por
    // isso não há leitura por autor_uid: o retorno é feito fora do sistema).
    match /assedio_relatos/{id} {
      allow create: if request.resource.data.autor_uid == null
        || (request.auth != null && request.resource.data.autor_uid == request.auth.uid);
      allow read, update, delete: if ehGenteCultura();
    }

    // Anexos do relato (prints, PDF, fotos): um doc por arquivo, ligado ao
    // relato por relato_id. Qualquer pessoa ENVIA junto com o relato; a
    // leitura fica travada só para Gente e Cultura, igual ao relato.
    match /assedio_anexos/{id} {
      allow create: if request.resource.data.relato_id is string
        && request.resource.data.relato_id.size() > 0;
      allow read, update, delete: if ehGenteCultura();
    }

    // -------- Humor da equipe (clima) — CSV importado pelo admin.
    // Contêm nome/matrícula: o admin lê/escreve tudo. O Gestor Aprovador LÊ só
    // os registros do SEU centro de custo (ou todos, se "Todos os centros"),
    // imposto AQUI (consulta por setor). Gestor nunca escreve. Público nunca acessa.
    match /humor_registros/{id} {
      allow read: if admin()
        || (temPapel('gestor') && (meuCentro() == 'Todos os centros de custo' || resource.data.get('setor', '') == meuCentro()));
      allow write: if admin();
    }

    // -------- Inconsistências (um doc por mês com a lista de itens).
    // Admin lê/escreve. O Gestor Aprovador LÊ o documento do mês (o recorte por
    // centro é feito na tela, pois o doc guarda todos os setores juntos).
    // Gestor nunca escreve.
    match /inconsistencias/{id} {
      allow read: if admin() || temPapel('gestor');
      allow write: if admin();
    }

    // -------- Solicitações de Reembolso --------
    // Fluxo: colaborador cria → gestor da área (ou Master, se quem pede é
    // gestor) → Financeiro. Visibilidade: o solicitante vê o seu; o gestor
    // vê só o próprio centro de custo; Master e Financeiro veem todos.
    match /reembolsos/{id} {
      function ehSolicitante() {
        return logado() && resource.data.solicitante_uid == request.auth.uid;
      }
      function gestorDoCentro() {
        return temPapel('gestor')
          && (meuCentro() == 'Todos os centros de custo' || resource.data.centro_custo == meuCentro());
      }
      // Pode decidir na etapa atual? (Master em tudo; gestor no seu centro na
      // etapa do gestor; financeiro na etapa financeira.) Nunca o próprio
      // pedido — exceto Master.
      function podeDecidir() {
        return (resource.data.solicitante_uid != request.auth.uid || ehMaster())
          && (
            ehMaster()
            || (resource.data.status == 'pendente_gestor' && gestorDoCentro())
            || (resource.data.status == 'pendente_financeiro' && temPapel('financeiro'))
          );
      }

      allow read: if ehMaster() || temPapel('financeiro') || ehSolicitante() || gestorDoCentro();

      // Criação: o solicitante grava o próprio pedido e NÃO pode escolher uma
      // etapa que pule o fluxo (o status inicial depende dos papéis de quem pede).
      allow create: if participante()
        && request.resource.data.solicitante_uid == request.auth.uid
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.centro_custo is string
        && request.resource.data.centro_custo.size() > 0
        && (
          (temPapel('gestor') && request.resource.data.status == 'pendente_master')
          || (!temPapel('gestor') && ehMaster() && request.resource.data.status == 'pendente_financeiro')
          || (!temPapel('gestor') && !ehMaster() && request.resource.data.status == 'pendente_gestor')
        );

      // O solicitante pode mexer no próprio pedido ENQUANTO não foi aprovado:
      // aguardando a 1ª aprovação (gestor/master) ou recusado.
      function editavelPeloDono() {
        return resource.data.solicitante_uid == request.auth.uid
          && resource.data.status in ['pendente_gestor', 'pendente_master', 'recusado'];
      }

      // Reedição pelo SOLICITANTE: ajusta o próprio pedido e o reenvia ao fluxo.
      // O centro/solicitante não mudam e o novo status é uma etapa pendente.
      function ehEdicaoSolicitante() {
        return editavelPeloDono()
          && request.resource.data.solicitante_uid == resource.data.solicitante_uid
          && request.resource.data.centro_custo == resource.data.centro_custo
          && request.resource.data.valor is number
          && request.resource.data.valor > 0
          && request.resource.data.status in ['pendente_gestor', 'pendente_master', 'pendente_financeiro']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'historico', 'atualizado_em', 'data_despesa', 'categoria', 'descricao', 'valor', 'tem_anexo', 'anexo_tipo', 'anexo_nome']);
      }

      // Atualização = decisão de aprovação/recusa (gestor/master) OU registro
      // de pagamento (financeiro/master) OU reedição do solicitante após recusa.
      // O núcleo é imutável na decisão; só status, histórico, data de
      // atualização e os campos de pagamento podem mudar.
      allow update: if (podeDecidir()
          && request.resource.data.solicitante_uid == resource.data.solicitante_uid
          && request.resource.data.valor == resource.data.valor
          && request.resource.data.centro_custo == resource.data.centro_custo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'historico', 'atualizado_em', 'data_pagamento', 'pago_por_nome', 'pago_em']))
        || ehEdicaoSolicitante();

      // Exclusão: o SOLICITANTE enquanto NÃO foi aprovado (aguardando ou
      // recusado); e o MASTER a qualquer momento (correções / limpeza de testes).
      allow delete: if editavelPeloDono() || ehMaster();
    }

    // -------- Anexos dos reembolsos (comprovantes) --------
    // Mesmo id do reembolso. Só quem pode ver o reembolso vê o comprovante.
    match /reembolso_anexos/{id} {
      function reembolso() {
        return get(/databases/$(database)/documents/reembolsos/$(id)).data;
      }
      function existeReembolso() {
        return exists(/databases/$(database)/documents/reembolsos/$(id));
      }
      allow read: if existeReembolso() && (
        ehMaster()
        || temPapel('financeiro')
        || reembolso().solicitante_uid == request.auth.uid
        || (temPapel('gestor') && reembolso().centro_custo == meuCentro())
      );
      // Criado junto com o reembolso, pelo próprio solicitante.
      allow create: if participante()
        && request.resource.data.solicitante_uid == request.auth.uid
        && existeReembolso()
        && reembolso().solicitante_uid == request.auth.uid;
      // Troca/remoção do comprovante SÓ pelo próprio solicitante e SÓ enquanto
      // o pedido não foi aprovado (aguardando aprovação ou recusado).
      function donoPodeMexer() {
        return existeReembolso()
          && reembolso().solicitante_uid == request.auth.uid
          && reembolso().status in ['pendente_gestor', 'pendente_master', 'recusado'];
      }
      allow update: if donoPodeMexer()
        && request.resource.data.solicitante_uid == request.auth.uid;
      allow delete: if donoPodeMexer() || ehMaster();
    }

    // -------- Notificações do portal (sino) --------
    // Avisos do fluxo de reembolso. Cada pessoa lê o que é endereçado ao seu
    // uid OU ao seu papel (gestor do centro / financeiro / master). Qualquer
    // participante CRIA (disparado pelas ações de solicitar/aprovar/pagar).
    // Imutável: o "lido" é por dispositivo (não grava aqui).
    match /notificacoes/{id} {
      allow read: if logado() && (
        resource.data.alvo == 'u:' + request.auth.uid
        || (resource.data.alvo == 'f' && temPapel('financeiro'))
        || (resource.data.alvo == 'm' && ehMaster())
        || (temPapel('gestor') && (
             resource.data.alvo == 'g:' + meuCentro()
             || (meuCentro() == 'Todos os centros de custo' && resource.data.alvo.matches('g:.*'))
           ))
      );
      allow create: if participante()
        && request.resource.data.alvo is string
        && request.resource.data.reembolso_id is string;
      allow update, delete: if false;
    }

    // -------- Progresso de Treinamento e Desenvolvimento (por usuário)
    // Cada participante (funcionário Comum ou admin) só lê e grava o SEU
    // próprio documento (id = uid). Admin pode ler todos para relatórios.
    match /treino_progresso/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow write: if participante() && request.auth.uid == uid;
    }

    // -------- Informações Administrativas --------
    // (legado) itens avulsos.
    match /info_admin/{id} {
      allow read: if participante();
      allow create, update, delete: if podeConteudo();
    }

    // Tópicos (cards) com vários itens (link/vídeo/foto/arquivo/texto).
    // Colaborador logado LÊ; admin/administrador cria/edita/remove.
    match /info_topicos/{id} {
      allow read: if participante();
      allow create, update, delete: if podeConteudo();
    }

    // Trilhas de Treinamento & Desenvolvimento. Público lê; admin/administrador grava.
    match /trilhas/{id} {
      allow read: if true;
      allow create, update, delete: if podeConteudo();
    }

    // -------- Sala de documentos por área (Central de Conhecimento) --------
    // Hierarquia: Área (centro de custo) > Módulo (tema) > Documento. Tanto o
    // módulo quanto o documento guardam o campo `area`. O colaborador lê só os
    // da PRÓPRIA área; Admin/RH (conteúdo) lê todas e gerencia. O recorte por
    // área é imposto AQUI: não dá para acessar os de outra área por URL direta
    // nem pela API (a leitura exige que a área bata com o centro de custo de
    // quem consulta).
    match /area_modulos/{id} {
      allow read: if admin() || (logado() && meuCentro() == resource.data.area);
      allow create, update, delete: if podeConteudo();
    }
    match /area_documentos/{id} {
      allow read: if admin() || (logado() && meuCentro() == resource.data.area);
      allow create, update, delete: if podeConteudo();
    }

    // -------- Trilhas de Desenvolvimento gamificadas (Fase 1) --------
    // Colaborador logado LÊ as trilhas e atividades; só conteúdo (admin/RH) edita.
    match /trilhas_dev/{id} {
      allow read: if participante();
      allow create, update, delete: if podeConteudo();
      match /atividades/{aid} {
        allow read: if participante();
        allow create, update, delete: if podeConteudo();
      }
    }
    // Progresso e pontos: cada pessoa lê e grava só o próprio doc; admin lê todos.
    match /trilhas_dev_progresso/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow write: if participante() && request.auth.uid == uid;
    }
    // Mural de conquistas: cada conclusão de trilha vira um registro público
    // (nome + trilha + setor + data). Participante logado LÊ; cada pessoa só
    // grava a PRÓPRIA conquista (id = uid_trilhaId, com uid == quem escreve).
    match /trilhas_dev_conquistas/{id} {
      allow read: if participante();
      allow create, update: if participante() && request.resource.data.uid == request.auth.uid;
      allow delete: if admin();
    }

    // -------- Banco de Horas (planilha mensal por matrícula) --------
    // Master vê/edita tudo. Gestor lê só o próprio centro (ou todos, se
    // "Todos os centros"). O colaborador lê só o próprio saldo (uid).
    // Só o Master grava (import). Filtro por área/uid é imposto AQUI.
    match /banco_horas/{id} {
      function gestorDoCentroBH() {
        return temPapel('gestor')
          && (meuCentro() == 'Todos os centros de custo' || resource.data.centro_custo == meuCentro());
      }
      allow read: if ehMaster()
        || gestorDoCentroBH()
        || (logado() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if ehMaster();
    }

    // -------- Aniversários / tempo de casa (projeção p/ o Mural)
    // Nome + área + dia/mês (nada de e-mail/matrícula). Agora exige LOGIN para
    // ler (não fica mais público, para não expor nome/área a quem não entrou);
    // só admin (Master) escreve — alimentado pelo cadastro/importação.
    match /aniversarios/{uid} {
      allow read: if logado();
      allow write: if admin();
    }

    // -------- Mural público (legado "Você disse, nós fizemos")
    match /mural/{id} {
      allow read: if true;
      allow create, update, delete: if podeConteudo();
    }

    // -------- Posts do mural: reconhecimentos aprovados + "Gente Informa"
    // Público lê os PUBLICADOS. Admin cria/edita/remove.
    // Reações: qualquer um soma no campo `reacoes` (e SÓ nesse campo),
    // e apenas em posts já publicados. Nada mais o público pode alterar.
    match /posts/{id} {
      allow read: if resource.data.publicado == true || podeConteudo();
      allow create, delete: if podeConteudo();
      // Reações: só PARTICIPANTE logado altera o contador (e só o campo `reacoes`).
      allow update: if podeConteudo() || (
        participante() &&
        resource.data.publicado == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
      );

      // Reação individual (identidade p/ moderação + trava de 1 por pessoa).
      match /reacoes/{ruid} {
        allow read: if podeConteudo() || (logado() && request.auth.uid == ruid);
        allow create, update, delete: if participante() && request.auth.uid == ruid;
      }

      // Comentários: só participante logado cria, IDENTIFICADO e pendente.
      // Público lê só os aprovados; admin/administrador lê todos, aprova e remove.
      match /comentarios/{cid} {
        allow read: if resource.data.aprovado == true || podeConteudo();
        allow create: if participante()
          && request.resource.data.aprovado == false
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 800;
        // Edição: admin/administrador edita qualquer um; o AUTOR edita só o
        // próprio texto (não altera aprovado/uid; só texto + marcas de "editado").
        allow update: if podeConteudo() || (
          participante()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editado', 'editado_em', 'aprovado'])
          && request.resource.data.aprovado == false
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 800
        );
        // Exclusão: admin/administrador OU o próprio autor.
        allow delete: if podeConteudo() || (participante() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
